{
  "name": "blondel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "dev": "pnpm --filter @blondel/web dev",
    "build": "pnpm --filter @blondel/web build",
    "rules:build": "node scripts/build-rules.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "fast-check": "^4.10.2",
    "yaml": "^2.9.1",
    "@types/node": "^24.0.0"
  }
}